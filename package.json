{
  "name": "jmxquery-mcp-server",
  "version": "1.0.0",
  "description": "JMX-QUERY MCP Server for Business Central",
  "author": "pro4dynamix GmbH",
  "license": "MIT",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && npm --prefix test-client run build && npm run notices",
    "notices": "node scripts/generate-third-party-notices.js",
    "test": "npm run test:mcp && npm run test:bootstrap && npm run test:security && npm run test:model",
    "test:security": "tsx --test test/security.test.ts",
    "test:mcp": "tsx --test test/mcp-workflow.test.ts",
    "test:bootstrap": "tsx --test test/bootstrap.test.ts",
    "bootstrap": "node scripts/bootstrap.js",
    "start": "node scripts/start.js",
    "dev": "tsx watch src/index.ts",
    "service:install": "node scripts/install-service.js",
    "service:uninstall": "node scripts/uninstall-service.js",
    "inspect": "npx @modelcontextprotocol/inspector node build/index.js",
    "inspect:dev": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "inspect:sse": "npx @modelcontextprotocol/inspector --transport sse --server-url http://127.0.0.1:5000/mcp/sse",
    "test:model": "tsx --test test/model.test.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^10.1.2",
    "@modelcontextprotocol/sdk": "^1.0.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "node-client-ntlm": "^0.0.6",
    "node-windows": "^1.0.0-beta.8",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "undici": "^7.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
