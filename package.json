{
  "name": "jmxq-mcp-server",
  "version": "1.0.0",
  "description": "JMX-QUERY MCP Server for Business Central",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsx watch src/index.ts",
    "service:install": "node scripts/install-service.js",
    "service:uninstall": "node scripts/uninstall-service.js",
    "inspect": "npx @modelcontextprotocol/inspector node build/index.js",
    "inspect:dev": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "inspect:sse": "npx @modelcontextprotocol/inspector --transport sse --server-url http://localhost:5000/mcp/sse --header \"Authorization: Bearer your-secret-key-123\""
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.0.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "node-client-ntlm": "^0.0.6",
    "node-windows": "^1.0.0-beta.8",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "undici": "^7.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}