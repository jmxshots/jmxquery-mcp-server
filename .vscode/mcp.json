{
  "inputs": [
    {
      "id": "jmx-query-api-key",
      "type": "promptString",
      "description": "JMX-QUERY MCP API key",
      "password": true
    }
  ],
  "servers": {
    "jmx-query": {
      "type": "http",
      "url": "http://127.0.0.1:5001/mcp/stream",
      "headers": {
        "Authorization": "Bearer ${input:jmx-query-api-key}"
      }
    }
  }
}