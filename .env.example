# Business Central OData Settings
BC_ODATA_BASE_URL=http://bc-server:7048/BC220/ODataV4/
BC_COMPANY=CRONUS Deutschland GmbH
BC_AUTH_TYPE=NTLM # BASIC, NTLM, or SSO
BC_USERNAME=replace_with_user # (Optional for SSO)
BC_PASSWORD=replace_with_password # (Optional for SSO)
JMXQ_EXECUTION_CONTEXT_CODE=DEFAULT

# MCP Server Settings
MCP_HOST=127.0.0.1
MCP_PORT=4000

# Optional: API Key for SSE Security
# If set, clients must provide this key in the Authorization header or ?apiKey= query param
MCP_API_KEY=your-secret-key-123

# Optional Settings
LOG_LEVEL=info
HTTP_TIMEOUT_MS=60000
