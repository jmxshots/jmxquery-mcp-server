# JMX-QUERY MCP Server configuration template.
# Copy this file to .env, replace every placeholder key, then restart the
# Node process or Windows service. Configure Business Central endpoints,
# authentication, and Companies in the protected Admin GUI.

# Network interface for the main HTTP listener. Bootstrap changes the loopback
# default to 0.0.0.0 for LAN access. Restrict inbound access with Windows Firewall.
MCP_HOST=127.0.0.1

# Main HTTP port. Hosts the Admin GUI (/admin), Admin API, SSE MCP, and, unless
# MCP_STREAMABLE_PORT is set, the Streamable HTTP MCP endpoint.
MCP_PORT=5000

# Optional separate port for Streamable HTTP MCP. Remove this line to serve it
# from MCP_PORT instead. Allowed value: an available TCP port from 1 to 65535.
MCP_STREAMABLE_PORT=5001

# Comma-separated browser origins allowed by CORS. Each value is scheme, host,
# and optional port, for example http://localhost:5000 or https://mcp.example.
# Do not use paths; trailing slashes are normalized automatically.
# For LAN browsers, add an origin such as http://jmxquery-host:5000.
# Bootstrap automatically adds the current computer hostname and MCP_PORT.
# For Azure App Proxy, add its public origin, for example https://jmxquery.example.msappproxy.net.
# This does not configure remote MCP clients. They use http://<host>:<MCP_STREAMABLE_PORT>/mcp/stream,
# or MCP_PORT when no separate MCP_STREAMABLE_PORT is configured.
MCP_CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# Optional bearer key for all HTTP MCP endpoints. When set, MCP clients must
# send: Authorization: Bearer <JMXQ_MCPAPI_KEY>. Use a unique random value of at
# least 32 characters. Leave empty only for a deliberately unauthenticated,
# local development setup.
JMXQ_MCPAPI_KEY=replace_with_a_long_random_mcp_key

# Enables the protected Admin API and the Admin GUI login. Only the literal
# value true enables it; false, empty, or an omitted value disables Admin API
# protection and the root redirect. Recommended value: true.
ADMIN_API_ENABLED=true

# Required when ADMIN_API_ENABLED=true. This is the Admin GUI/API bearer key,
# separate from JMXQ_MCPAPI_KEY. Use a unique random value of at least 10 characters.
ADMIN_API_KEY=replace_with_a_long_random_admin_key

# Required: encryption master key for the Instance and Company registry. It
# must contain at least 32 characters. Keep it stable: changing it makes the
# existing encrypted store unreadable. Use a unique random value.
INSTANCE_MASTER_KEY=replace_with_a_long_random_master_key_at_least_32_characters

# Encrypted Instance/Company registry location. Relative paths are resolved
# from the service working directory. Back up this file together with the
# unchanged INSTANCE_MASTER_KEY.
INSTANCE_STORE_PATH=./data/instances.enc

# Directory for daily JSONL audit logs. Ensure the service account can create
# and write files here.
LOG_DIR=./logs

# Number of daily log files retained. Allowed values: whole numbers from 0.
# Use 0 to remove files older than the current day during retention cleanup.
LOG_RETENTION_DAYS=30

# Maximum number of characters retained for a jmxq_executeScript audit entry.
# Allowed values: whole numbers from 1 to 100000. Business Central responses
# and credentials are never written to these logs.
LOG_SCRIPT_MAX_LENGTH=4000

# Server logging threshold. Allowed values: debug, info, warn, error.
# Use debug only temporarily because it produces more operational output.
LOG_LEVEL=info
